# AWS RDS PostgreSQL (SSL is enforced by the app and by prisma.config.ts)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Optional: path-free PEM contents of the RDS CA bundle to enable full certificate verification
# DATABASE_CA_CERT=
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# Password applied to demo users created by `npm run db:seed`
SEED_PASSWORD=choose-a-demo-password
